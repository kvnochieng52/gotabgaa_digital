# ============================================================
# Gotabgaa Digital — monorepo .gitignore
# Covers root, frontend (Next.js) and backend (Laravel)
# ============================================================

# ---------- macOS & OS junk ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ---------- Editor / IDE ----------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.project
.settings/
.classpath

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
!.env.local.example
auth.json

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ============================================================
# FRONTEND (Next.js + Turbopack)
# ============================================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/

# Turbopack / bundler caches
frontend/.turbo/
frontend/.swc/
frontend/.parcel-cache/

# Testing / coverage
frontend/coverage/
frontend/.nyc_output/

# TypeScript
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# Vercel
frontend/.vercel/

# Local envs (allow examples in git)
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Old-website snapshot & DB dump — NEVER commit these:
#   - Contains user data (emails, hashed passwords)
#   - Contains full bundled JS from old site
frontend/gotabgaa_staging.sql
frontend/live_old_website/node_modules/
frontend/live_old_website/gotabgaa-frontend/node_modules/

# ============================================================
# BACKEND (Laravel + Filament)
# ============================================================
backend/vendor/
backend/node_modules/
backend/public/hot
backend/public/storage
backend/public/build/

# Laravel storage — ignore runtime contents but KEEP the directory tree.
# Each subdir ships a `.gitignore` that says `*` + `!.gitignore` so the folders
# themselves are committed (Laravel needs them to exist on boot) but their
# generated contents (cache, sessions, views, logs) are not.
backend/storage/*.key
backend/storage/debugbar/
backend/storage/pail/
backend/storage/app/livewire-tmp/

# Database
backend/database/database.sqlite
backend/database/database.sqlite-journal
backend/database/*.sql

# Bootstrap cache
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

# Config caches
backend/.phpunit.result.cache
backend/.phpunit.cache/

# Local dev tooling
backend/Homestead.json
backend/Homestead.yaml
backend/.rr.yaml
backend/.env.backup
backend/.env.production

# Filament
backend/public/js/filament/
backend/public/css/filament/

# ---------- Import artifacts (root) ----------
gotabgaa_staging.sql
*.dump
*.bak
*.tmp

# ============================================================
# MOBILE APP (Flutter — app/)
# ============================================================
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.metadata
app/.packages
app/build/
app/.pub-cache/
app/.pub/

# Android build output
app/android/.gradle/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/android/local.properties
app/android/**/*.keystore
app/android/key.properties
app/android/gradle-wrapper.jar

# iOS build output + Pods
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/App.framework
app/ios/Flutter/flutter_export_environment.sh
app/ios/Runner/GeneratedPluginRegistrant.*
app/ios/ServiceDefinitions.json
app/ios/Runner.xcodeproj/**/xcuserdata/
app/ios/Runner.xcodeproj/xcshareddata/
app/ios/Runner.xcworkspace/xcuserdata/
app/ios/Runner.xcworkspace/xcshareddata/

# IDEs
app/.idea/
app/*.iml
app/*.ipr
app/*.iws

# Uploaded show photos are checked in (they're brand assets),
# but keep dev snapshots at the root out of the repo:
/screenshot-*.png
/tmp-*.png

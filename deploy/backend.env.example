# ============================================================
# Backend (Laravel) — production .env
# Copy to /app/gotabgaa/backend/.env and edit the values.
#   sudo cp deploy/backend.env.example backend/.env
#   sudo -u www-data php artisan key:generate
# ============================================================

APP_NAME="Gotabgaa Digital"
APP_ENV=production
APP_KEY=                                      # `php artisan key:generate` will fill this
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://SERVER_IP:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --------- Logging ---------
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --------- Database (MySQL in production) ---------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gotabgaa_digital
DB_USERNAME=gotabgaa
DB_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# --------- Staging import (only needed once during content migration) ---------
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=3306
STAGING_DB_DATABASE=gotabgaa_stg_import
STAGING_DB_USERNAME=gotabgaa
STAGING_DB_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# --------- Cache / Queue / Session ---------
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --------- CORS ---------
# Since our frontend is served by the SAME nginx server (same origin),
# CORS only matters if you host the frontend on a different domain.
CORS_ALLOWED_ORIGINS=http://SERVER_IP:8090

# --------- Mail (optional) ---------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@gotabgaa.digital"
MAIL_FROM_NAME="${APP_NAME}"

# --------- Filesystem ---------
FILESYSTEM_DISK=public

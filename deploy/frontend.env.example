# ============================================================
# Frontend (Next.js) — production .env
# Copy to /app/gotabgaa/frontend/.env.production and edit.
#   cp deploy/frontend.env.example frontend/.env.production
# ============================================================

# Public API base URL. This is what the browser calls at runtime,
# so it MUST be a URL reachable from the visitor's browser — not localhost.
#
# Since we route both frontend and backend through the same nginx block,
# use the SAME host+port as the site itself:
NEXT_PUBLIC_API_URL=http://SERVER_IP:8090
